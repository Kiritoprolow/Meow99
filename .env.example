# ===== Gateway (đặt trong Hugging Face Space > Settings > Variables and secrets) =====
# Xác thực: cần ít nhất MỘT trong hai (>=24 ký tự ngẫu nhiên, tạo bằng: python -c "import secrets;print(secrets.token_urlsafe(32))")
MCP_API_KEY=your-mcp-api-key-here
MCP_PATH_SECRET=your-mcp-path-secret-here

# GitHub: fine-grained token, CHỈ repo này, quyền Actions: Read and write
GITHUB_TOKEN=your-github-token-here
GITHUB_REPO=owner/ten-repo
GITHUB_WORKFLOW=render.yml
GITHUB_REF_NAME=main

# Hugging Face: token có quyền ghi vào repo dataset bên dưới
HF_TOKEN=your-hf-token-here
HF_STATE_REPO=user/video-studio-data      # lưu request.json/status.json
HF_OUTPUT_REPO=user/video-studio-data     # lưu thành phẩm (có thể trùng hoặc khác STATE)

# Tùy chọn
STORE_BACKEND=hub
MAX_DURATION_SECONDS=120
RATE_LIMIT_PER_MIN=60
CREATE_LIMIT_PER_HOUR=10

# ===== GitHub Actions (repo > Settings > Secrets and variables > Actions) =====
# Secrets:   HF_TOKEN, (tùy chọn) YOUTUBE_CLIENT_ID, YOUTUBE_CLIENT_SECRET, YOUTUBE_REFRESH_TOKEN
# Variables: HF_STATE_REPO, HF_OUTPUT_REPO
